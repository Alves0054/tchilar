PORT=4000
NODE_ENV=development
# Só em desenvolvimento: devolve os links de confirmação/recuperação na resposta da API
# (para testar sem SMTP). Sem isto, o link aparece no terminal do servidor.
# Nunca ligues isto num servidor acessível por outras pessoas.
DEV_EXPOSE_AUTH_LINKS=false
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
POSTGRES_PASSWORD=replace_with_a_random_password
DATABASE_URL=postgresql://biva:replace_with_a_random_password@localhost:5432/biva
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
# Optional public API origin for production builds; development uses the Vite proxy.
# VITE_API_URL=https://api.example.com
# Optional public URLs for Docker deployments
# PUBLIC_CLIENT_URL=https://social.example.com
# PUBLIC_APP_URL=https://social.example.com
UPLOAD_DIR=uploads
# Email (confirmação de conta, recuperação, avisos) pelo Resend (resend.com), por SMTP.
# Plano grátis: 3 000 emails/mês e 100 por dia. Pro: 20 USD/mês, 50 000/mês, sem limite diário.
# SMTP_USER é sempre "resend" e SMTP_PASSWORD é a chave da API (re_...). Nunca pôr a chave no git.
# O domínio tchilar.ao tem de estar verificado no Resend (registos SPF e DKIM) para o SMTP_FROM funcionar.
# Códigos por SMS/WhatsApp (Twilio Verify). SMS_CHANNELS=whatsapp,sms põe o WhatsApp primeiro (normalmente mais barato;
# precisa de um remetente WhatsApp no serviço Verify). SMS_DAILY_LIMIT = teto de códigos por dia no Tchilar inteiro
# (protege a fatura do Twilio; 0 = sem teto). Cada número recebe no máximo 1 código por minuto e 5 por dia.
SMS_CHANNELS=sms
SMS_DAILY_LIMIT=300
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM="Tchilar <nao-responder@tchilar.ao>"
# Empresa que emite os recibos e assina o rodapé dos emails (bilhetes, recibos).
COMPANY_NAME="Alves Estúdio"
COMPANY_NIF=5001541781
COMPANY_ADDRESS="Luanda, Angola"
COMPANY_EMAIL=
# Fila de emails: máximo de emails nas últimas 24 h e na última hora (0 = sem limite). Resend grátis: 100 por dia;
# no plano Pro põe EMAIL_DAILY_LIMIT=0. Os emails de conta saem primeiro; os que não couberem esperam a vez.
EMAIL_DAILY_LIMIT=100
EMAIL_HOURLY_LIMIT=0
# Limites gerais por IP (além do login, recuperação, SMS, pesquisa e denúncias): escritas por 5 min e pagamentos
# começados por 10 min. O nginx também limita 30 pedidos/s por IP.
RATE_LIMIT_WRITES=300
RATE_LIMIT_PAYMENTS=30
# Pagamentos de subscrições (Stripe). Sem chave, em desenvolvimento as subscrições
# funcionam em modo demonstração (30 dias, sem pagamento); em produção ficam desativadas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUBSCRIPTION_CURRENCY=aoa
# Pagamento por Referência (ProxyPay API v2). PROXYPAY_ENV=sandbox só em desenvolvimento (o servidor
# recusa arrancar com sandbox fora de NODE_ENV=development); production para o real.
# O botão "simular pagamento" só existe com sandbox + PAYMENTS_DEMO=true.
PROXYPAY_API_KEY=
PROXYPAY_ENTITY_ID=
PROXYPAY_ENV=sandbox
# Multicaixa Express (Paybyrd). A chave de teste ou real define o modo.
PAYBYRD_API_KEY=

# Pagamentos internacionais (cobram em dólares). Quantos kwanzas vale 1 dólar: atualiza quando o câmbio mudar.
# O valor em dólares é arredondado para cima (nunca recebes menos do que o preço em Kz).
PAYMENTS_KZ_PER_USD=920
# Endereço público da API (o PayPal devolve a pessoa a https://api.tchilar.ao/api/payments/paypal/return).
API_PUBLIC_URL=

# PayPal (developer.paypal.com → Apps & Credentials). PAYPAL_ENV=sandbox para testes, live a sério.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

# RedotPay Connect. Obtém APP_KEY e a chave pública da RedotPay no portal; guarda a chave privada RSA
# do comerciante apenas aqui (usa \n para representar quebras de linha). Em produção usa REDOTPAY_ENV=production.
REDOTPAY_APP_KEY=
REDOTPAY_PRIVATE_KEY=
REDOTPAY_PLATFORM_PUBLIC_KEY=
REDOTPAY_KEY_VERSION=1
REDOTPAY_ENV=sandbox
REDOTPAY_CURRENCY=USD

# PayPay Africa (pagamento na app PayPay, em kwanzas). Precisa de conta empresarial PayPay: a equipa comercial dá o
# Partner ID, o Sale Product Code e o endereço da API. Gera um par de chaves RSA de 1024 bits
# (openssl genrsa -out private.key 1024 && openssl rsa -in private.key -pubout -out public.key), carrega a PÚBLICA
# no portal PayPay (API Settings) e põe aqui a PRIVADA (numa linha, com no lugar das quebras de linha).
# PAYPAY_PUBLIC_KEY: a chave pública da PayPay (portal → API Settings), para confirmar os avisos deles.
# Endereço dos avisos a pôr no portal: https://api.tchilar.ao/api/webhooks/paypay
PAYPAY_PARTNER_ID=
PAYPAY_PRIVATE_KEY=
PAYPAY_PUBLIC_KEY=
PAYPAY_SALE_PRODUCT_CODE=
# Vazio = https://gateway.paypayafrica.com/recv.do. Se a PayPay te der outro endereço, põe-no aqui.
PAYPAY_API_URL=
# Só em desenvolvimento: sem nenhum método de pagamento configurado, ativa compras SEM cobrar
# (para testar estrelas e promoções). Desligado por omissão: não ligues num link público.
PAYMENTS_DEMO=false
# Número de proxies à frente do servidor (1 com nginx). Sem isto, os limites de tentativas
# tratariam todas as pessoas como uma só.
TRUST_PROXY=0
# Diretos: servidor TURN (coturn). Com TURN, o vídeo passa pela retransmissão e ninguém vê o IP de ninguém.
# LIVE_TURN_SECRET = static-auth-secret do coturn (credenciais temporárias de 12 h para cada pessoa).
LIVE_TURN_URL=
LIVE_TURN_SECRET=
LIVE_TURN_RELAY_ONLY=true
# Diretos para milhares de pessoas e OBS (deploy/README.md, secção 6). Vazios = modo direto até 8 pessoas.
# MEDIA_HOOK_SECRET: openssl rand -hex 32 (o MediaMTX usa-o para pedir autorização à Tchilar).
MEDIA_HOOK_SECRET=
MEDIA_API_URL=
MEDIA_RTMP_URL=
MEDIA_WHIP_URL=
MEDIA_HLS_URL=
MEDIA_PUBLIC_HOST=

# Várias cópias da API (deploy/README.md, secção 7). Vazio = uma cópia, limites em memória.
REDIS_URL=
# Alertas (deploy/healthcheck.sh e deploy/backup.sh). Ex.: https://ntfy.sh/um-topico-dificil-de-adivinhar
ALERT_WEBHOOK_URL=
# Cópias de segurança (deploy/backup.sh)
BACKUP_DIR=/var/backups/tchilar
KEEP_DAYS=14
RCLONE_REMOTE=
# Chave (32 bytes, hex) para cifrar os IBAN dos criadores e os segredos da verificação em dois passos. Obrigatória em produção.
# Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_ENCRYPTION_KEY=

# Notificações push da app (serviço de push do Expo). Funciona sem chave; com "Enhanced security" ligada
# no projeto Expo, cria um Access Token em expo.dev e põe-no aqui. PUSH_NOTIFICATIONS=false desliga o envio.
# SMS (Twilio Verify): confirmar o telemóvel e recuperar a conta por SMS. Em console.twilio.com: Account SID e
# Auth Token (página inicial) e um serviço em Verify → Services (o SID começa por VA). Em Messaging → Settings →
# Geo permissions, liga os países da CPLP (Angola, Brasil, Portugal, Moçambique...). Sem isto, em desenvolvimento o
# código aparece no terminal da API; em produção o SMS fica indisponível.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

EXPO_ACCESS_TOKEN=
PUSH_NOTIFICATIONS=true

# Notificações no browser (web push), com o site fechado. Gera as chaves UMA vez com:
#   npx web-push generate-vapid-keys
# Não mudes as chaves depois: quem já tinha os avisos ligados teria de os ligar outra vez.
# Sem chaves, o interruptor "Avisos no browser" aparece como indisponível.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Contacto para os serviços de push (Google, Mozilla, Apple) em caso de problema.
WEB_PUSH_SUBJECT=mailto:suporte@tchilar.ao

# Desafios do mês: no início de cada mês a API lança 1 desafio por nível do catálogo (só estrelas, sem dinheiro),
# se a equipa ainda não tiver lançado. CHALLENGES_AUTO=false desliga (a equipa lança à mão no painel).
CHALLENGES_AUTO=true

# Links do site que abrem a app (depois do primeiro build no EAS):
# APPLE_TEAM_ID = Team ID da conta Apple Developer (10 caracteres)
# ANDROID_CERT_SHA256 = impressão SHA-256 do certificado (npx eas-cli credentials -p android); várias separadas por vírgula
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
