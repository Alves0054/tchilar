PORT=4000
NODE_ENV=development
# Só em desenvolvimento: devolve os links de confirmação/recuperação na resposta da API
# (para testar sem SMTP). Sem isto, o link aparece no terminal do servidor.
# Nunca ligues isto num servidor acessível por outras pessoas.
DEV_EXPOSE_AUTH_LINKS=false
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
POSTGRES_PASSWORD=replace_with_a_random_password
DATABASE_URL=postgresql://biva:replace_with_a_random_password@localhost:5432/biva
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
# Optional public API origin for production builds; development uses the Vite proxy.
# VITE_API_URL=https://api.example.com
# Optional public URLs for Docker deployments
# PUBLIC_CLIENT_URL=https://social.example.com
# PUBLIC_APP_URL=https://social.example.com
UPLOAD_DIR=uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Pagamentos de subscrições (Stripe). Sem chave, em desenvolvimento as subscrições
# funcionam em modo demonstração (30 dias, sem pagamento); em produção ficam desativadas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUBSCRIPTION_CURRENCY=aoa
# Pagamento por Referência (ProxyPay API v2). PROXYPAY_ENV=sandbox só em desenvolvimento (o servidor
# recusa arrancar com sandbox fora de NODE_ENV=development); production para o real.
# O botão "simular pagamento" só existe com sandbox + PAYMENTS_DEMO=true.
PROXYPAY_API_KEY=
PROXYPAY_ENTITY_ID=
PROXYPAY_ENV=sandbox
# Multicaixa Express (Paybyrd). A chave de teste ou real define o modo.
PAYBYRD_API_KEY=
# Só em desenvolvimento: sem nenhum método de pagamento configurado, ativa compras SEM cobrar
# (para testar estrelas e promoções). Desligado por omissão: não ligues num link público.
PAYMENTS_DEMO=false
# Número de proxies à frente do servidor (1 com nginx). Sem isto, os limites de tentativas
# tratariam todas as pessoas como uma só.
TRUST_PROXY=0
# Diretos: servidor TURN (coturn). Com TURN, o vídeo passa pela retransmissão e ninguém vê o IP de ninguém.
# LIVE_TURN_SECRET = static-auth-secret do coturn (credenciais temporárias de 12 h para cada pessoa).
LIVE_TURN_URL=
LIVE_TURN_SECRET=
LIVE_TURN_RELAY_ONLY=true
# Alertas (deploy/healthcheck.sh e deploy/backup.sh). Ex.: https://ntfy.sh/um-topico-dificil-de-adivinhar
ALERT_WEBHOOK_URL=
# Cópias de segurança (deploy/backup.sh)
BACKUP_DIR=/var/backups/biva
KEEP_DAYS=14
RCLONE_REMOTE=
# Chave (32 bytes, hex) para cifrar os IBAN dos criadores e os segredos da verificação em dois passos. Obrigatória em produção.
# Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_ENCRYPTION_KEY=
