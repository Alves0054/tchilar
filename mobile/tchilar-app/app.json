    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tchilar-splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/tchilar-splash-dark.png",
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-audio",
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E30613"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Tchilar usa o Face ID para desbloquear a app, se ligares o bloqueio nas definições."
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "O Tchilar usa a câmara para diretos, fotos e para ler os bilhetes dos teus eventos à entrada.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "tchilar",
    "description": "Tchilar — a rede social angolana: partilha momentos, conversa, faz chamadas, entra em diretos e encontra a tua comunidade."
  }
