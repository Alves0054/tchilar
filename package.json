{
  "name": "creator-social",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test server/index.test.js server/migrate.test.js server/subscriptions.test.js",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-database.ps1",
    "db:migrate": "node server/migrate-cli.js",
    "db:seed-demo": "node server/seed-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.65.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.2"
  }
}
