{
  // Verificação de tipos sobre o JavaScript existente (sem mudar para TypeScript): apanha argumentos
  // errados, propriedades que não existem e valores possivelmente indefinidos antes de chegarem a produção.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true
  },
  "include": ["server/**/*.js"],
  "exclude": ["server/**/*.test.js"]
}
