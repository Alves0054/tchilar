{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tchilar-api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server/index.js"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "tchilar-web",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "tchilar-expo",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["expo", "start", "--lan", "--port", "8081"],
      "cwd": "mobile/tchilar-app",
      "port": 8081,
      "autoPort": false
    }
  ]
}
