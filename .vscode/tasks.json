			"label": "Configurar PostgreSQL existente (avançado)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts\\setup-database.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Preparar Biva (base de dados + perfil demo)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"scripts\\setup-biva-demo.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Iniciar Biva (frontend + API)",
			"type": "shell",
			"command": "npm.cmd",
			"args": ["run", "dev"],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}